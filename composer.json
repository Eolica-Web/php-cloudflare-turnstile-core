{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "eolica/cloudflare-turnstile",
    "description": "Cloudflare Turnstile integration for PHP",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "cloudflare",
        "turnstile",
        "captcha"
    ],
    "authors": [
        {
            "name": "David Llobell",
            "email": "dllobell@eolicadigital.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/Eolica-Web/php-cloudflare-turnstile-core",
    "require": {
        "php": "^8.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Eolica\\CloudflareTurnstile\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    }
}
